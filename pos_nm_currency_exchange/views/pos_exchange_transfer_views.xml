<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Note transfers between the counters of an exchange office. -->
    <record id="view_pos_nm_exchange_transfer_list" model="ir.ui.view">
        <field name="name">pos.nm.exchange.transfer.list</field>
        <field name="model">pos.nm.exchange.transfer</field>
        <field name="arch" type="xml">
            <list string="Note Transfers" decoration-info="state == 'sent'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="office_id" optional="show"/>
                <field name="config_from_id"/>
                <field name="config_to_id"/>
                <field name="currency_id" optional="hide"/>
                <field name="amount"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="value" sum="Value" optional="show"/>
                <field name="sent_date" optional="show"/>
                <field name="received_date" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'sent'"
                       decoration-success="state == 'received'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pos_nm_exchange_transfer_form" model="ir.ui.view">
        <field name="name">pos.nm.exchange.transfer.form</field>
        <field name="model">pos.nm.exchange.transfer</field>
        <field name="arch" type="xml">
            <form string="Note Transfer">
                <header>
                    <button name="action_send" type="object" string="Send" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Take the notes out of the drawer of the sending counter, in its open session?"/>
                    <button name="action_receive" type="object" string="Receive" class="btn-primary"
                            invisible="state != 'sent'"
                            confirm="Put the notes in the drawer of the receiving counter, in its open session?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'sent')"
                            confirm="Cancel the transfer? Notes in transit go back to the drawer of the sending counter."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_statement_lines" type="object" class="oe_stat_button"
                                icon="fa-money" string="Cash Moves" invisible="state == 'draft'"/>
                        <button name="action_view_note_moves" type="object" class="oe_stat_button"
                                icon="fa-list-ol" string="Note Moves" invisible="not note_move_ids"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="office_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="config_from_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="config_to_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="value" invisible="state == 'draft'"/>
                            <field name="notes_label" invisible="not notes_label"/>
                            <field name="note_move_ids" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Sent" invisible="not sent_date">
                            <field name="session_from_id"/>
                            <field name="sent_date"/>
                            <field name="sent_user_id"/>
                            <field name="statement_line_from_id" groups="base.group_no_one"/>
                        </group>
                        <group string="Received" invisible="not received_date">
                            <field name="session_to_id"/>
                            <field name="received_date"/>
                            <field name="received_user_id"/>
                            <field name="statement_line_to_id" groups="base.group_no_one"/>
                        </group>
                        <group string="Cancelled" invisible="not cancel_date">
                            <field name="cancel_date"/>
                            <field name="cancel_user_id"/>
                            <field name="statement_line_cancel_id" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Note"/>
                    <div class="text-muted" invisible="state != 'draft'">
                        Send takes the notes out of the drawer of the sending counter in its open session, on the
                        notes in transit account of the office; Receive puts them in the drawer of the receiving
                        counter in its open session. When the sending counter tracks the notes by denomination, the
                        notes proposed from its stock are sent: send them from the register to choose them.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pos_nm_exchange_transfer_search" model="ir.ui.view">
        <field name="name">pos.nm.exchange.transfer.search</field>
        <field name="model">pos.nm.exchange.transfer</field>
        <field name="arch" type="xml">
            <search string="Note Transfers">
                <field name="name"/>
                <field name="office_id"/>
                <field name="config_from_id"/>
                <field name="config_to_id"/>
                <field name="currency_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Transit" name="in_transit" domain="[('state', '=', 'sent')]"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Sent On" name="sent_date" date="sent_date"/>
                <group>
                    <filter string="Office" name="group_by_office" domain="[]" context="{'group_by': 'office_id'}"/>
                    <filter string="From Counter" name="group_by_from" domain="[]" context="{'group_by': 'config_from_id'}"/>
                    <filter string="To Counter" name="group_by_to" domain="[]" context="{'group_by': 'config_to_id'}"/>
                    <filter string="Currency" name="group_by_currency" domain="[]" context="{'group_by': 'currency_id'}"/>
                    <filter string="Status" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_nm_exchange_transfer" model="ir.actions.act_window">
        <field name="name">Note Transfers</field>
        <field name="res_model">pos.nm.exchange.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Transfer notes between the counters of an office</p>
            <p>
                A transfer takes notes out of the drawer of a counter and puts them in the drawer of another counter
                of the same exchange office, through its notes in transit account. The cashiers send and receive
                them from the menu of the register.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_pos_nm_exchange_transfer"
        name="Note Transfers"
        parent="point_of_sale.menu_point_of_sale"
        sequence="56"
        action="action_pos_nm_exchange_transfer"
        groups="point_of_sale.group_pos_manager"/>

    <!-- Drawers of an exchange office (page of the office form):
        drawers is pos.nm.exchange.office._nm_drawers(). -->
    <template id="exchange_office_drawers">
        <div class="o_nm_office_drawers">
            <p t-if="not drawers['counters']" class="text-muted">No counter of the office has an open session.</p>
            <table t-else="" class="table table-sm o_nm_office_drawers_counters">
                <thead>
                    <tr>
                        <th>Counter</th>
                        <th>Session</th>
                        <th>Expected Cash</th>
                        <th class="text-end">Operations Today</th>
                        <th class="text-end">Commissions Today</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="drawers['counters']" t-as="counter">
                        <td t-out="counter['config']"/>
                        <td t-out="counter['session']"/>
                        <td>
                            <div t-foreach="counter['cash']" t-as="cash">
                                <span t-out="cash['currency']"/>: <span class="font-monospace" t-out="cash['amount_formatted']"/>
                            </div>
                        </td>
                        <td class="text-end" t-out="counter['operation_count']"/>
                        <td class="text-end font-monospace" t-out="counter['commission_formatted']"/>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3">Total</td>
                        <td class="text-end" t-out="drawers['operation_count']"/>
                        <td class="text-end font-monospace" t-out="drawers['commission_formatted']"/>
                    </tr>
                </tfoot>
            </table>
            <h5 class="mt-3">Notes in Transit</h5>
            <p t-if="not drawers['in_transit']" class="text-muted">No note in transit.</p>
            <table t-else="" class="table table-sm o_nm_office_drawers_transit">
                <thead>
                    <tr>
                        <th>Currency</th>
                        <th class="text-end">Transfers</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Value</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="drawers['in_transit']" t-as="row">
                        <td t-out="row['currency']"/>
                        <td class="text-end" t-out="row['count']"/>
                        <td class="text-end font-monospace" t-out="row['amount_formatted']"/>
                        <td class="text-end font-monospace" t-out="row['value_formatted']"/>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3">Total in transit</td>
                        <td class="text-end font-monospace" t-out="drawers['in_transit_value_formatted']"/>
                    </tr>
                </tfoot>
            </table>
        </div>
    </template>
</odoo>
