<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Exchange receipt handed to the customer, printed from the register
            (same layout as the cash move receipt). -->
        <template id="pos_exchange_receipt">
            <html id="pos-receipt">
                <head>
                    <meta charset="UTF-8"></meta>
                    <t t-call="point_of_sale.pos_order_receipt_style" />
                </head>
                <body>
                    <div class="pos-receipt">
                        <div class="w-100 text-center mb-3" name="logo">
                            <img t-if="image.get('logo')" t-att-src="image['logo']" style="max-height: 75px" />
                        </div>
                        <t t-call="pos_nm_currency_exchange.pos_exchange_receipt_body"/>
                        <t t-call="point_of_sale.company_info_receipt"/>
                        <div t-if="extra_data.get('receipt_footer')" class="w-100 text-center mt-2 mb-2" style="white-space:pre-line"
                             t-out="extra_data['receipt_footer']"/>
                    </div>
                </body>
            </html>
        </template>

        <!-- Content of the exchange receipt, also printed in the PDF of the
            operation: extra_data is pos.nm.exchange._nm_receipt_data(). -->
        <template id="pos_exchange_receipt_body">
            <div t-if="extra_data.get('receipt_header')" class="text-center mb-1" style="white-space:pre-line"
                 t-out="extra_data['receipt_header']"/>
            <div class="text-center text-large fw-bold">CURRENCY EXCHANGE</div>
            <div class="text-center" t-if="extra_data.get('licence')">
                Licence No. <span t-out="extra_data['licence']"/>
            </div>
            <div class="text-center text-large nm-exchange-operation-type" t-out="extra_data['operation_type']"/>
            <div class="text-center">
                <span t-out="extra_data['name']" /> - <span t-out="extra_data['date']" />
            </div>
            <div class="text-center text-large fw-bold nm-exchange-cancelled" t-if="extra_data.get('cancelled')">
                CANCELLED <span t-out="extra_data['cancel_date']"/>
            </div>
            <div class="text-center fw-bold nm-exchange-copy" t-if="extra_data.get('copy')">COPY</div>
            <div class="text-center" t-if="extra_data.get('cashier_name')">
                Served by <span t-out="extra_data['cashier_name']" />
            </div>
            <div class="text-center" t-if="extra_data.get('partner_name')">
                Customer: <span t-out="extra_data['partner_name']" />
            </div>
            <div class="text-center" t-if="extra_data.get('id_document')">
                <span t-out="extra_data['id_document']" />
            </div>
            <table class="w-100 text-large mt-3">
                <tbody>
                    <tr>
                        <td class="text-start" t-out="extra_data['label_in']"/>
                        <td class="text-end font-monospace" t-out="extra_data['amount_in']" />
                    </tr>
                    <tr class="text-bold fw-bold">
                        <td class="text-start" t-out="extra_data['label_out']"/>
                        <td class="text-end font-monospace" t-out="extra_data['amount_out']" />
                    </tr>
                    <tr>
                        <td class="text-start">Rate applied</td>
                        <td class="text-end font-monospace" t-out="extra_data['rate_label']" />
                    </tr>
                    <tr>
                        <td class="text-start">Commission</td>
                        <td class="text-end font-monospace" t-out="extra_data['commission']" />
                    </tr>
                </tbody>
            </table>
            <div t-if="extra_data.get('note')" class="text-center mt-2" t-out="extra_data['note']"/>
        </template>

        <!-- Rate board printed from the register: extra_data is
            pos.config._nm_rate_board(). -->
        <template id="pos_exchange_rates_receipt">
            <html id="pos-receipt">
                <head>
                    <meta charset="UTF-8"></meta>
                    <t t-call="point_of_sale.pos_order_receipt_style" />
                </head>
                <body>
                    <div class="pos-receipt">
                        <div class="w-100 text-center mb-3" name="logo">
                            <img t-if="image.get('logo')" t-att-src="image['logo']" style="max-height: 75px" />
                        </div>
                        <div class="text-center text-large fw-bold">EXCHANGE RATES</div>
                        <div class="text-center" t-if="extra_data.get('licence')">
                            Licence No. <span t-out="extra_data['licence']"/>
                        </div>
                        <div class="text-center" t-out="extra_data['date']"/>
                        <t t-foreach="extra_data['rows']" t-as="row">
                            <div class="text-large fw-bold mt-3" t-out="row['currency']"/>
                            <table class="w-100">
                                <tbody>
                                    <tr>
                                        <td class="text-start">We buy</td>
                                        <td class="text-end font-monospace" t-out="row['buy_rate_label']"/>
                                    </tr>
                                    <tr>
                                        <td class="text-start"><span t-out="row['amount_formatted']"/> &#8594;</td>
                                        <td class="text-end font-monospace" t-out="row['buy_amount_formatted']"/>
                                    </tr>
                                    <tr>
                                        <td class="text-start">We sell</td>
                                        <td class="text-end font-monospace" t-out="row['sell_rate_label']"/>
                                    </tr>
                                    <tr>
                                        <td class="text-start"><span t-out="row['amount_formatted']"/> &#8592;</td>
                                        <td class="text-end font-monospace" t-out="row['sell_amount_formatted']"/>
                                    </tr>
                                    <tr>
                                        <td class="text-start">Commission</td>
                                        <td class="text-end font-monospace">
                                            <span t-out="row['commission_percent']"/> % + <span t-out="row['commission_fixed']"/>,
                                            min. <span t-out="row['commission_min']"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <div class="text-center text-small mt-3">
                            Rates before the commission; the amounts include it and are rounded to the notes and coins.
                        </div>
                        <t t-call="point_of_sale.company_info_receipt"/>
                    </div>
                </body>
            </html>
        </template>
    </data>
</odoo>
