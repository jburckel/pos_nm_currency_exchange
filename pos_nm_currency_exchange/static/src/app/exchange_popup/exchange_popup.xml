<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_nm_currency_exchange.CurrencyExchangePopup">
        <Dialog title.translate="Currency Exchange" size="'md'" contentClass="'nm-currency-exchange'">
            <div class="d-flex flex-column gap-3">
                <div class="row g-3">
                    <div class="col-12 col-md-5">
                        <label class="form-label">Received from the customer</label>
                        <div class="input-group">
                            <select class="form-select form-select-lg nm-exchange-currency-in" t-on-change="this.onCurrencyInChange">
                                <option t-foreach="this.currencies" t-as="currency" t-key="currency.id"
                                        t-att-value="currency.id" t-att-selected="currency.id === this.state.currencyInId"
                                        t-out="currency.name"/>
                            </select>
                            <input type="text" class="form-control form-control-lg nm-exchange-amount-in" placeholder="0.00"
                                   t-att-value="this.state.amountIn"
                                   t-att-class="{'is-invalid': this.state.amountIn and !this.pos.isValidFloat(this.state.amountIn)}"
                                   t-on-input="this.onAmountInput" t-on-blur="this.onAmountBlur"
                                   t-on-focus="(ev) => ev.target.select()"/>
                        </div>
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-end justify-content-center">
                        <button class="btn btn-secondary btn-lg nm-exchange-swap" type="button" title="Swap the currencies" t-on-click="this.swap">
                            <i class="oi" data-icon="swap_horiz" role="img" aria-label="Swap"/>
                        </button>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label">Handed back to the customer</label>
                        <div class="input-group">
                            <select class="form-select form-select-lg nm-exchange-currency-out" t-on-change="this.onCurrencyOutChange">
                                <option t-foreach="this.currencies" t-as="currency" t-key="currency.id"
                                        t-att-value="currency.id" t-att-selected="currency.id === this.state.currencyOutId"
                                        t-out="currency.name"/>
                            </select>
                            <span class="form-control form-control-lg text-end fw-bolder nm-exchange-amount-out">
                                <t t-if="this.state.quote" t-out="this.state.quote.amount_out_formatted"/>
                                <t t-elif="this.state.loading">...</t>
                                <t t-else="">-</t>
                            </span>
                        </div>
                    </div>
                </div>
                <div t-if="this.state.quote" class="d-flex flex-column text-muted nm-exchange-quote">
                    <div class="d-flex justify-content-between"><span>Rate</span><span class="nm-exchange-rate" t-out="this.state.quote.rate_label"/></div>
                    <div class="d-flex justify-content-between"><span>Value of the notes received</span><span t-out="this.state.quote.value_in_formatted"/></div>
                    <div class="d-flex justify-content-between"><span>Commission</span><span class="nm-exchange-commission" t-out="this.state.quote.commission_formatted"/></div>
                </div>
                <div t-if="this.coinStepWarning" class="alert alert-warning py-2 mb-0 nm-exchange-step-warning" role="alert" t-out="this.coinStepWarning"/>
                <div t-if="this.state.error" class="alert alert-danger py-2 mb-0 nm-exchange-error" role="alert" t-out="this.state.error"/>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-secondary btn-lg nm-exchange-customer" type="button" t-on-click="this.selectCustomer"
                            t-att-class="{'btn-outline-danger': this.customerRequired}">
                        <i class="oi me-1" data-icon="person" role="img" aria-hidden="true"/>
                        <t t-out="this.customerLabel"/>
                    </button>
                    <button t-if="this.state.partner" class="btn btn-link" type="button" t-on-click="this.clearCustomer">Clear</button>
                    <span t-if="this.customerRequired" class="text-danger small nm-exchange-customer-required">A customer must be identified for this amount.</span>
                </div>
                <input type="text" class="form-control nm-exchange-note" placeholder="Note (optional)"
                       t-att-value="this.state.note" t-on-input="(ev) => this.state.note = ev.target.value"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg nm-exchange-confirm" t-att-disabled="!this.isValid or this.state.saving" t-on-click="this.confirm">Confirm</button>
                <button class="btn btn-secondary btn-lg" t-on-click="() => this.props.close()">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
