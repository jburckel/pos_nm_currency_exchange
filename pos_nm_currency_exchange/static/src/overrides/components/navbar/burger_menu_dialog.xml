<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_nm_currency_exchange.BurgerMenuDialog" t-inherit="point_of_sale.BurgerMenuDialog" t-inherit-mode="extension">
        <xpath expr="//t[@dataIcon=&quot;'refresh'&quot;]" position="before">
            <t t-if="this.pos.nmShowExchangeButton"
               t-call="point_of_sale.BurgerDialogMenuButton"
               dataIcon="'attach_money'"
               onClick="() => this.pos.nmCurrencyExchange()"
               btnLabel.translate="Currency Exchange"
            />
            <t t-if="this.pos.nmShowExchangeButton"
               t-call="point_of_sale.BurgerDialogMenuButton"
               dataIcon="'article'"
               onClick="() => this.pos.nmExchangeOperations()"
               btnLabel.translate="Exchange Operations"
            />
            <t t-if="this.pos.nmShowExchangeButton"
               t-call="point_of_sale.BurgerDialogMenuButton"
               dataIcon="'show_chart'"
               onClick="() => this.pos.nmExchangeRates()"
               btnLabel.translate="Exchange Rates"
            />
            <t t-if="this.pos.nmShowNoteStock"
               t-call="point_of_sale.BurgerDialogMenuButton"
               dataIcon="'payments'"
               onClick="() => this.pos.nmNoteStock()"
               btnLabel.translate="Note Stock"
            />
            <t t-if="this.pos.nmShowTransfers"
               t-call="point_of_sale.BurgerDialogMenuButton"
               dataIcon="'send'"
               onClick="() => this.pos.nmSendNotes()"
               btnLabel.translate="Send Notes"
            />
            <t t-if="this.pos.nmShowTransfers"
               t-call="point_of_sale.BurgerDialogMenuButton"
               dataIcon="'download'"
               onClick="() => this.pos.nmReceiveNotes()"
               btnLabel.translate="Receive Notes"
            />
        </xpath>
    </t>
</templates>
