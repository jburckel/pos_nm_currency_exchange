<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_pos_nm_exchange" model="ir.sequence">
            <field name="name">POS Currency Exchange</field>
            <field name="code">pos.nm.exchange</field>
            <field name="prefix">EXC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_pos_nm_exchange_register_closing" model="ir.sequence">
            <field name="name">Exchange Register Closing</field>
            <field name="code">pos.nm.exchange.register.closing</field>
            <field name="prefix">EXR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_pos_nm_exchange_transfer" model="ir.sequence">
            <field name="name">Note Transfer</field>
            <field name="code">pos.nm.exchange.transfer</field>
            <field name="prefix">TRF/%(year)s/</field>
            <field name="padding">5</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
